{
  "name": "specyard",
  "version": "0.1.0",
  "description": "Local UI over the spec-driven Claude Code skill workflow",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "specyard": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config ui/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "diff": "9.0.0",
    "marked": "18.1.3",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
